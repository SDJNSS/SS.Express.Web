{
  "name": "landlink-logistics-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@8.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "dev": "vite",
    "ui:dev": "vite --config UIDesign/vite.config.ts",
    "ui:typecheck": "vue-tsc --noEmit -p UIDesign/tsconfig.json",
    "ui:build": "vite build --config UIDesign/vite.config.ts",
    "ui:preview": "vite preview --config UIDesign/vite.config.ts",
    "build": "vue-tsc -b && vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json",
    "design:check": "designmd lint DESIGN.md && node scripts/check-design-context.mjs",
    "standards:check": "node scripts/check-frontend-standards.mjs",
    "prototype:legacy-check": "node scripts/check-prototype-governance.mjs",
    "page-contract:check": "node scripts/check-page-contracts.mjs --profile base",
    "page-contract:preview": "node scripts/check-page-contracts.mjs --profile preview",
    "page-contract:production": "node scripts/check-page-contracts.mjs --profile production",
    "resource-catalog:generate": "node scripts/generate-resource-catalog.mjs",
    "resource-catalog:check": "node scripts/generate-resource-catalog.mjs --check",
    "prototype:check": "pnpm prototype:legacy-check && pnpm page-contract:check",
    "lint:code": "eslint . --max-warnings=0",
    "lint": "pnpm lint:code && pnpm design:check && pnpm standards:check && pnpm prototype:check && pnpm resource-catalog:check",
    "test:typecheck": "tsc --noEmit -p tsconfig.tests.json",
    "test:governance": "node --test tests/governance/*.test.mjs",
    "test:visual": "playwright test",
    "test:production-routing": "playwright test --config playwright.production.config.ts",
    "test:visual:update": "playwright test --update-snapshots",
    "quality": "pnpm lint && pnpm test:governance && pnpm typecheck && pnpm ui:typecheck && pnpm test:typecheck && pnpm build && pnpm test:production-routing && pnpm ui:build && pnpm test:visual",
    "format": "prettier --write .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@iconify-icons/mdi": "^2.0.0",
    "@iconify/vue": "^5.0.0",
    "axios": "^1.11.0",
    "dayjs": "^1.11.13",
    "echarts": "^6.0.0",
    "element-plus": "^2.11.1",
    "pinia": "^3.0.3",
    "vue": "^3.5.20",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@google/design.md": "^0.4.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.3.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.8.1",
    "ajv": "^8.20.0",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.4.0",
    "prettier": "^3.6.2",
    "sass": "^1.90.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.41.0",
    "vite": "^7.1.3",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.0.6",
    "yaml": "^2.9.0"
  }
}
