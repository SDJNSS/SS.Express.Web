# 浏览器请求统一前缀。开发环境建议保持相对路径并通过 Vite 代理后端。
VITE_API_BASE_URL=/api
VITE_API_TIMEOUT_MS=15000
# 文件上传单独设置超时（毫秒），避免大视频被普通接口的 15 秒超时中断。
VITE_API_UPLOAD_TIMEOUT_MS=600000
VITE_API_WITH_CREDENTIALS=false

# 按后端统一响应协议调整；SS.Express.Platform 当前成功码为 1。
VITE_API_SUCCESS_CODES=0,1,200,SUCCESS

# 仅供 Vite 开发服务器使用，不会注入浏览器代码。
DEV_API_TARGET=https://localhost:7112
# 独立 DMS 文件服务；生产环境在统一网关转发 /dms。
DEV_DMS_FILE_API_TARGET=https://localhost:7225
# 本地 HTTPS 开发证书通常为自签名；生产环境不要关闭证书校验。
DEV_API_SECURE=false
