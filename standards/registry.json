      "pageTypes": ["FormPage"],
      "shellMode": "content"
    },
    "DashboardPageTemplate": {
      "canonicalImplementation": "src/shared/components/page-templates/DashboardPageTemplate.vue",
      "owner": "shared/page-patterns",
      "verificationEntry": "standards",
      "pageTypes": ["DashboardPage"],
      "shellMode": "content"
    },
    "WorkspacePageTemplate": {
      "canonicalImplementation": "src/shared/components/page-templates/WorkspacePageTemplate.vue",
      "owner": "shared/page-patterns",
      "verificationEntry": "standards",
      "pageTypes": ["WorkspacePage"],
      "shellMode": "content"
    },
    "WizardPageTemplate": {
      "canonicalImplementation": "src/shared/components/page-templates/WizardPageTemplate.vue",
      "owner": "shared/page-patterns",
      "verificationEntry": "standards",
      "pageTypes": ["WizardPage"],
      "shellMode": "content"
    },
    "AuthPageTemplate": {
      "canonicalImplementation": "src/shared/components/page-templates/AuthPageTemplate.vue",
      "owner": "shared/page-patterns",
      "verificationEntry": "standards",
      "pageTypes": ["AuthPage"],
      "shellMode": "standalone"
