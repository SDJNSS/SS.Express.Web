{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ss.express.local/schemas/page-contract.v0.1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "page",
    "sources",
    "implementation",
    "composition",
    "states",
    "interactions",
    "mockScenarios",
    "exceptions",
    "issues",
    "acceptance",
    "verification"
  ],
  "properties": {
    "schemaVersion": { "const": "0.1" },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "feature", "type", "patternKey", "revision"],
      "properties": {
        "id": { "$ref": "#/$defs/key" },
        "name": { "type": "string", "minLength": 1 },
        "feature": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*/[a-z][a-z0-9-]*$"
        },
        "type": { "$ref": "#/$defs/pascalKey" },
        "patternKey": { "$ref": "#/$defs/pascalKey" },
        "revision": { "type": "integer", "minimum": 1 }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputMode", "prd", "api", "permissions", "ux", "references"],
      "properties": {
        "inputMode": { "enum": ["prd-only", "prd-with-reference"] },
        "prd": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sourceRef" }
        },
        "api": { "type": "array", "items": { "$ref": "#/$defs/sourceRef" } },
        "permissions": { "type": "array", "items": { "$ref": "#/$defs/sourceRef" } },
        "ux": { "type": "array", "items": { "$ref": "#/$defs/sourceRef" } },
        "references": { "type": "array", "items": { "$ref": "#/$defs/referenceSource" } }
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonicalEntry", "previewEntry", "previewBinding"],
      "properties": {
        "canonicalEntry": { "$ref": "#/$defs/projectPath" },
        "previewEntry": { "$ref": "#/$defs/projectPath" },
        "previewBinding": { "$ref": "#/$defs/projectPath" },
        "productionBinding": { "$ref": "#/$defs/projectPath" },
        "productionRoute": { "type": "string", "pattern": "^/[a-z0-9][A-Za-z0-9:/-]*$" },
        "routeSource": { "$ref": "#/$defs/projectPath" }
      }
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layoutKey", "regions", "components"],
      "properties": {
        "layoutKey": { "$ref": "#/$defs/pascalKey" },
        "regions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/region" }
        },
        "components": {
          "type": "array",
          "items": { "$ref": "#/$defs/componentRef" }
        }
      }
    },
    "states": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/state" }
    },
    "interactions": {
      "type": "array",
      "items": { "$ref": "#/$defs/interaction" }
    },
    "mockScenarios": {
      "type": "array",
      "items": { "$ref": "#/$defs/mockScenario" }
    },
    "exceptions": {
      "type": "array",
      "items": { "$ref": "#/$defs/exception" }
    },
    "issues": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blockers", "deferred", "outOfScope"],
      "properties": {
        "blockers": { "type": "array", "items": { "$ref": "#/$defs/issue" } },
        "deferred": { "type": "array", "items": { "$ref": "#/$defs/issue" } },
        "outOfScope": { "type": "array", "items": { "$ref": "#/$defs/issue" } }
      }
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/acceptance" }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["viewports", "browserTests"],
      "properties": {
        "viewports": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/key" }
        },
        "browserTests": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/projectPath" }
        }
      }
    }
  },
  "$defs": {
    "key": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "pascalKey": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
    "projectPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ref"],
      "properties": {
        "id": { "$ref": "#/$defs/key" },
        "ref": { "$ref": "#/$defs/projectPath" },
        "section": { "type": "string", "minLength": 1 },
        "operation": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1 }
      }
    },
    "referenceSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ref", "origin", "kind"],
      "properties": {
        "id": { "$ref": "#/$defs/key" },
        "ref": { "$ref": "#/$defs/projectPath" },
        "origin": { "enum": ["user", "project"] },
        "kind": { "enum": ["image", "figma", "legacy-page", "approved-page", "document"] },
        "section": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1 }
      }
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "order"],
      "properties": {
        "id": { "$ref": "#/$defs/key" },
        "role": {
          "enum": ["header", "search", "actions", "summary", "data", "detail", "form", "navigation", "feedback", "other"]
        },
        "order": { "type": "integer", "minimum": 1 },
        "parentId": { "$ref": "#/$defs/key" }
      }
    },
    "componentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "componentKey", "regionId", "purpose"],
      "properties": {
        "id": { "$ref": "#/$defs/key" },
        "componentKey": {
          "type": "string",
          "pattern": "^(?:shared|business|feature)\\.[a-z][a-z0-9.-]*$"
        },
        "regionId": { "$ref": "#/$defs/key" },
        "purpose": { "type": "string", "minLength": 1 }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "scopeRef", "observableResult"],
      "properties": {
        "id": { "$ref": "#/$defs/key" },
        "isDefault": { "type": "boolean" },
        "scopeRef": { "type": "string", "minLength": 1 },
        "observableResult": { "type": "string", "minLength": 1 },
        "ruleRef": { "$ref": "#/$defs/key" }
      }
    },
    "interaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "trigger", "targetRef", "observableResult", "ruleRef"],
      "properties": {
        "id": { "$ref": "#/$defs/key" },
        "trigger": { "type": "string", "minLength": 1 },
        "targetRef": { "type": "string", "minLength": 1 },
        "observableResult": { "type": "string", "minLength": 1 },
        "ruleRef": { "$ref": "#/$defs/key" }
      }
    },
    "mockScenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "fixtureRef", "stateRef"],
      "properties": {
        "id": { "$ref": "#/$defs/key" },
        "isDefault": { "type": "boolean" },
        "fixtureRef": { "$ref": "#/$defs/projectPath" },
        "stateRef": { "$ref": "#/$defs/key" },
        "permissionRef": { "$ref": "#/$defs/key" },
        "permissionFixtureRef": { "$ref": "#/$defs/projectPath" },
        "acceptanceRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/key" }
        }
      }
    },
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "standardRef", "scopeRef", "reason"],
      "properties": {
        "id": { "$ref": "#/$defs/key" },
        "standardRef": { "type": "string", "minLength": 1 },
        "scopeRef": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "affectedScopes"],
      "properties": {
        "id": { "$ref": "#/$defs/key" },
        "description": { "type": "string", "minLength": 1 },
        "affectedScopes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/approvalScope" }
        },
        "owner": { "type": "string", "minLength": 1 },
        "resolutionTarget": { "type": "string", "minLength": 1 }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sourceRef", "observableResult", "affectedScopes"],
      "properties": {
        "id": { "$ref": "#/$defs/key" },
        "sourceRef": { "$ref": "#/$defs/key" },
        "observableResult": { "type": "string", "minLength": 1 },
        "affectedScopes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/approvalScope" }
        },
        "stateRef": { "$ref": "#/$defs/key" },
        "interactionRef": { "$ref": "#/$defs/key" },
        "testRef": { "$ref": "#/$defs/projectPath" }
      }
    },
    "approvalScope": {
      "enum": ["preview-visual", "preview-interaction", "production-binding", "production-regression"]
    }
  }
}
