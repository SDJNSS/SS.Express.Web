{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "sources", "chains"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "2.0" },
    "notes": { "type": "array", "items": { "$ref": "#/$defs/text" } },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "sha256", "candidates_hash", "status", "reason"],
        "additionalProperties": false,
        "properties": {
          "file": { "$ref": "#/$defs/text" },
          "sha256": { "$ref": "#/$defs/hash" },
          "candidates_hash": { "$ref": "#/$defs/hash" },
          "status": { "enum": ["pending", "reviewed"] },
          "reason": { "$ref": "#/$defs/text" },
          "reviewed_by": { "$ref": "#/$defs/text" },
          "evidence": { "$ref": "#/$defs/evidence" },
          "dependency_hash": { "$ref": "#/$defs/hash" },
          "candidate_reviews": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["candidate_ids", "classification", "reason", "chain_ids"],
              "properties": {
                "candidate_ids": { "$ref": "#/$defs/ids" },
                "classification": {
                  "enum": [
                    "local",
                    "mock",
                    "business",
                    "public",
                    "session_self_service",
                    "infrastructure",
                    "delegated"
                  ]
                },
                "reason": { "$ref": "#/$defs/text" },
                "chain_ids": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": { "$ref": "#/$defs/text" }
                }
              }
            }
          }
        },
        "allOf": [
          {
            "if": { "properties": { "status": { "const": "reviewed" } }, "required": ["status"] },
            "then": {
              "properties": {
                "reviewed_by": {},
                "evidence": {},
                "dependency_hash": {},
                "candidate_reviews": {}
              },
              "required": ["reviewed_by", "evidence", "dependency_hash", "candidate_reviews"]
            }
          }
        ]
      }
    },
    "chains": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "chain_id",
          "behavior",
          "callbacks",
          "candidate_ids",
          "requests",
          "dependencies",
          "evidence"
        ],
        "properties": {
          "chain_id": { "$ref": "#/$defs/text" },
          "behavior": { "$ref": "#/$defs/text" },
          "callbacks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["file", "symbol"],
              "properties": {
                "file": { "$ref": "#/$defs/text" },
                "symbol": { "$ref": "#/$defs/text" }
              }
            }
          },
          "candidate_ids": { "$ref": "#/$defs/ids" },
          "requests": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["candidate_id", "endpoint", "function_resource_code", "function_sha256"],
              "properties": {
                "candidate_id": { "$ref": "#/$defs/text" },
                "endpoint": { "$ref": "#/$defs/text" },
                "function_resource_code": { "$ref": "#/$defs/text" },
                "function_sha256": { "$ref": "#/$defs/hash" }
              }
            }
          },
          "dependencies": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["file", "sha256"],
              "properties": {
                "file": { "$ref": "#/$defs/text" },
                "sha256": { "$ref": "#/$defs/hash" }
              }
            }
          },
          "evidence": { "$ref": "#/$defs/evidence" }
        }
      }
    }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/text" }
    },
    "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/text" } }
  }
}
